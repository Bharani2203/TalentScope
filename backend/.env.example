# Firebase Admin SDK uses Application Default Credentials.
# For local development, set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.
# Never commit service-account JSON files or real secrets.
ENVIRONMENT=development
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=skill-demand-forecasting
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
JSEARCH_TIMEOUT_SECONDS=12
JSEARCH_MAX_RETRIES=1
JSEARCH_RETRY_BACKOFF_SECONDS=0.25

# External data provider credentials. Keep real values in an untracked .env file.
JSEARCH_API_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com
GITHUB_TOKEN=
GITHUB_TOPIC=python
GITHUB_TIMEOUT_SECONDS=12
GITHUB_MAX_RETRIES=1
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_TIMEOUT_SECONDS=12
ADZUNA_MAX_RETRIES=1
JOB_SEARCH_LIVE_ENABLED=false
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=
GEMINI_B_API_KEY=
GEMINI_B_MODEL=gemini-3.8-flash
GEMINI_B_BACKUP_MODEL=
# Separate, opt-in Learning roadmap enrichment. Add the key locally in backend/.env.
LEARNING_GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=
LEARNING_GEMINI_MODEL=gemini-3.8-flash
LEARNING_GEMINI_REQUEST_TIMEOUT_SECONDS=8
LEARNING_GEMINI_MAX_CALLS_PER_MINUTE=4
LEARNING_GEMINI_MAX_CALLS_PER_DAY=60
LEARNING_GEMINI_MAX_CALLS_PER_USER_PER_HOUR=3
LEARNING_GEMINI_MAX_OUTPUT_TOKENS=1200
# YouTube Data API v3 key for dynamic topic video enrichment & caching (optional)
YOUTUBE_API_KEY=
# Gemini B application-side limits; process-local and separate from Gemini A.
GEMINI_B_MAX_CALLS_PER_MINUTE=10
GEMINI_B_MAX_CALLS_PER_DAY=100
GEMINI_B_MAX_CALLS_PER_USER_PER_HOUR=10
GEMINI_B_REQUEST_TIMEOUT_SECONDS=5
GEMINI_B_MAX_INPUT_CHARS=3000
GEMINI_B_MAX_OUTPUT_TOKENS=512
# Application-side guardrails; these are not claims about a Gemini free-tier quota.
GEMINI_MAX_CALLS_PER_MINUTE=60
GEMINI_MAX_CALLS_PER_DAY=1500
GEMINI_MAX_CALLS_PER_USER_PER_HOUR=30
GEMINI_MAX_INPUT_CHARS=12000
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_REQUEST_TIMEOUT_SECONDS=5
YOUTUBE_API_KEY=
# SQLite market history (path is relative to the backend working directory).
SKILL_INTELLIGENCE_DB_PATH=data/skill_intelligence.sqlite3
SKILL_INTELLIGENCE_MIN_PERIODS=4
SKILL_INTELLIGENCE_READ_BACKEND=firestore

# Remote code compiler sandbox service (Piston, Judge0, or JDoodle).
# Keep credentials on backend only. Never expose to client.
COMPILER_ENABLED=false
COMPILER_PROVIDER=jdoodle
COMPILER_API_URL=https://api.jdoodle.com/v1/execute
COMPILER_API_KEY=
COMPILER_TIMEOUT_SECONDS=10
# JDoodle authentication credentials
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
JDOODLE_API_URL=https://api.jdoodle.com/v1/execute

# Key 2 (Your 2nd email account)
JDOODLE_CLIENT_ID_2=
JDOODLE_CLIENT_SECRET_2=

# Key 3 (Your 3rd email account)
JDOODLE_CLIENT_ID_3=
JDOODLE_CLIENT_SECRET_3=
# Key 4 (Your 4th email account)
JDOODLE_CLIENT_ID_4=
JDOODLE_CLIENT_SECRET_4=

