      "language": "sql",
      "test_cases": [
        {
          "schema": "CREATE TABLE scores(category TEXT, score REAL);",
          "setup_rows": [
            [
              "a",
              2
            ],
            [
              "a",
              4
            ],
            [
              "b",
              9
            ]
          ],
          "query": "SELECT category, AVG(score) AS average_score FROM scores GROUP BY category HAVING COUNT(*) >= 2 ORDER BY average_score DESC;",
          "expected_output": [
            [
              "a",
              3.0
            ]
          ],
          "hidden": true
        }
      ]
