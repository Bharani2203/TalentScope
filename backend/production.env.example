# ==============================================================================
# TalentScope.ai Production Environment Configuration & Deployment Checklist
# ==============================================================================
# Use this file as a checklist when configuring production deployment platforms
# (e.g., Vercel, Render, Heroku, AWS ECS, Fly.io, Railway).
#
# CRITICAL SECTION 6 CONSTRAINTS & PRODUCTION SECURITY RULES:
# 1. Authentic enterprise data only; zero synthetic/hallucinated records.
# 2. Never commit actual secret keys or credentials to version control.
# 3. DO NOT set emulator flags in production!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["https://talentscope.ai","https://app.talentscope.ai"]

# ------------------------------------------------------------------------------
# 2. FIREBASE PRODUCTION CREDENTIALS (NO EMULATORS!)
# ------------------------------------------------------------------------------
# CRITICAL: The following two emulator environment variables MUST NOT BE SET in production:
# ❌ DO NOT SET: FIRESTORE_EMULATOR_HOST
# ❌ DO NOT SET: FIREBASE_AUTH_EMULATOR_HOST
# ❌ DO NOT SET: TALENTSCOPE_FIREBASE_MODE=emulator
# ❌ DO NOT SET: TALENTSCOPE_OFFLINE_TEST_MODE=1

# Production Firebase Project ID (live Google Cloud project):
FIREBASE_PROJECT_ID=skill-demand-forecasting

# Provide service account credentials using EITHER Option A OR Option B:
#
# Option A (Recommended for Render, Heroku, Vercel, Cloud Run):
# Base64-encoded string of your service-account JSON:
# Generated via: base64 -w 0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsICJwcm9qZWN0X2lkIjogInNraWxsLWRlbWFuZC1mb3JlY2FzdGluZyIsIC...

# Option B (File path on container / volume mount):
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=/etc/secrets/firebase-service-account.json

# ------------------------------------------------------------------------------
# 3. PRODUCTION POSTGRESQL DATABASE (LIVE HOSTED INSTANCE)
# ------------------------------------------------------------------------------
# CRITICAL: Must point to your live hosted PostgreSQL instance
# (e.g., Supabase, Neon, AWS RDS, Render Postgres, Heroku Postgres)
# rather than localhost:5432!
#
# Dynamic connection string format:
# postgresql://<user>:<password>@<live-db-host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres.your-project-id:your-secure-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Alternatively, individual connection parameters can be provided:
# PGHOST=aws-0-us-east-1.pooler.supabase.com
# PGPORT=6543
# PGDATABASE=postgres
# PGUSER=postgres.your-project-id
# PGPASSWORD=your-secure-password
# PGCONNECT_TIMEOUT=5

# ------------------------------------------------------------------------------
# 4. EXTERNAL DATA PIPELINES & REQUISITION APIS (AUTHENTIC ENTERPRISE DATA)
# ------------------------------------------------------------------------------
# Adzuna API (Live UK/US/India Enterprise Job Postings):
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in
ADZUNA_TIMEOUT_SECONDS=12
ADZUNA_MAX_RETRIES=2

# RapidAPI / JSearch API:
JSEARCH_API_KEY=your_rapidapi_jsearch_key
RAPIDAPI_HOST=jsearch.p.rapidapi.com
JSEARCH_TIMEOUT_SECONDS=12
JSEARCH_MAX_RETRIES=1

# Greenhouse / Lever / Ashby Integrations (Direct ATS connectors):
JOB_SEARCH_LIVE_ENABLED=true

# GitHub Developer Ecosystem Telemetry:
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_TOPIC=python
GITHUB_TIMEOUT_SECONDS=12
GITHUB_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI SERVICES (WITH RESILIENT MULTI-KEY FALLBACK)
# ------------------------------------------------------------------------------
# Configure primary and prioritized fallback keys for 100% SLA during quota limits:
GEMINI_API_KEY=your_primary_gemini_key
GEMINI_API_A_KEY=your_fallback_key_a
GEMINI_API_B_KEY=your_fallback_key_b
GEMINI_API_C_KEY=your_fallback_key_c
GEMINI_MODEL=gemini-1.5-flash

# Learning Curriculum Gemini Service:
LEARNING_GEMINI_API_KEY=your_learning_gemini_key
LEARNING_GEMINI_MODEL=gemini-1.5-flash
LEARNING_GEMINI_REQUEST_TIMEOUT_SECONDS=10
LEARNING_GEMINI_MAX_CALLS_PER_MINUTE=20
LEARNING_GEMINI_MAX_CALLS_PER_DAY=1000

# YouTube Data API v3 (for Learning video enrichment):
YOUTUBE_API_KEY=your_youtube_api_key

# ------------------------------------------------------------------------------
# 6. CODE COMPILER SANDBOX (OPT-IN PISTON / JUDOODLE)
# ------------------------------------------------------------------------------
COMPILER_ENABLED=true
COMPILER_PROVIDER=jdoodle
JDOODLE_CLIENT_ID=your_jdoodle_client_id
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret
JDOODLE_API_URL=https://api.jdoodle.com/v1/execute
COMPILER_TIMEOUT_SECONDS=10

